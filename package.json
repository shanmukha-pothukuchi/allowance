{
  "name": "allowance",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Allowance: a safe wallet for your AI agent, plus the agent-work protocol for getting paid",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "setup": "tsx apps/agents/src/setup.ts",
    "dev": "concurrently -k -n facilitator,wallet,merchant,directory,shopify,quantcomm,computer,notifier,dashboard,agents,brokerage,scheduler -c cyan,green,yellow,gray,greenBright,blueBright,cyanBright,magenta,blue,white,redBright,greenBright \"npm:dev:facilitator\" \"npm:dev:wallet\" \"npm:dev:merchant\" \"npm:dev:directory\" \"npm:dev:shopify\" \"npm:dev:quantcomm-bridge\" \"npm:dev:computer-use\" \"npm:dev:notifier\" \"npm:dev:dashboard\" \"npm:dev:agents\" \"npm:dev:brokerage\" \"npm:dev:scheduler\"",
    "dev:facilitator": "tsx watch apps/mock-facilitator/src/index.ts",
    "dev:wallet": "tsx watch apps/wallet-service/src/index.ts",
    "dev:merchant": "tsx watch apps/merchant/src/index.ts",
    "dev:notifier": "tsx watch apps/notifier/src/index.ts",
    "dev:dashboard": "npm run dev --workspace apps/dashboard",
    "demo": "tsx apps/agents/src/demo.ts",
    "reset": "tsx apps/agents/src/reset.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev:agents": "tsx watch apps/agent-chat/src/index.ts",
    "demo:scripted": "tsx apps/agents/src/demo.ts",
    "dev:directory": "tsx watch apps/directory/src/index.ts",
    "dev:shopify": "tsx watch apps/shopify-bridge/src/index.ts",
    "dev:quantcomm-bridge": "tsx watch apps/quantcomm-bridge/src/index.ts",
    "dev:computer-use": "tsx watch --include apps/computer-use/docker apps/computer-use/src/index.ts",
    "computer-use:image": "tsx apps/computer-use/src/build-image.ts",
    "computer-use:e2e": "tsx apps/computer-use/src/e2e.ts",
    "dev:brokerage": "tsx watch apps/brokerage/src/index.ts",
    "dev:scheduler": "tsx watch apps/scheduler/src/index.ts"
  },
  "dependencies": {
    "@fontsource/google-sans": "^5.3.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@x402/core": "^2.28.0",
    "@x402/evm": "^2.28.0",
    "@x402/express": "^2.28.0",
    "@x402/fetch": "^2.28.0",
    "chalk": "^6.0.1",
    "express": "^5.3.0",
    "grammy": "^1.46.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "viem": "^2.57.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
