<?xml version="1.0" encoding="UTF-8"?>
<!-- Minimal Openbox: no decorations, every window maximized at 0,0, no WM key or mouse bindings,
     so the screen is exactly what the agent sees and screen coordinates match the page. -->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <focus>
    <focusNew>yes</focusNew>
    <followMouse>no</followMouse>
  </focus>
  <placement>
    <policy>Smart</policy>
  </placement>
  <desktops>
    <number>1</number>
  </desktops>
  <keyboard></keyboard>
  <mouse></mouse>
  <applications>
    <application class="*">
      <decor>no</decor>
      <maximized>yes</maximized>
      <position force="yes"><x>0</x><y>0</y></position>
    </application>
  </applications>
</openbox_config>
