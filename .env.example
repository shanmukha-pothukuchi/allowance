# ---- Settlement mode ----------------------------------------------------------
# mock         : fully offline. In-memory USDC ledger + local x402 facilitator.
# base-sepolia : real Base Sepolia testnet (USDC 0x036CbD53842c5426634e7929541eC2318f3dCF7e). NEVER mainnet.
CHAIN_MODE=mock

# ---- Ports / URLs (defaults shown) --------------------------------------------
FACILITATOR_PORT=4030
FACILITATOR_URL=http://localhost:4030
WALLET_SERVICE_PORT=4010
WALLET_SERVICE_URL=http://localhost:4010
MERCHANT_PORT=4021
MERCHANT_URL=http://localhost:4021
DASHBOARD_PORT=4040

DIRECTORY_PORT=4060
DIRECTORY_URL=http://localhost:4060
SHOPIFY_BRIDGE_PORT=4070
SHOPIFY_BRIDGE_URL=http://localhost:4070
AGENT_CHAT_PORT=4050
# AGENT_CHAT_HOST=127.0.0.1         # whoever can reach the chat server can instruct the agents

# ---- LLM for the chat agents (OpenAI-compatible chat completions) -----------
# Default: NRP managed LLMs. Get a token at https://nrp.ai/llmtoken/ (institutional login).
LLM_BASE_URL=https://ellm.nrp-nautilus.io/v1
LLM_API_KEY=
# qwen3 and gpt-oss allow 16 concurrent requests per user on NRP (enough for the 4-worker race).
LLM_MODEL=qwen3
# Optional JSON merged into every request, e.g. turn off thinking for faster replies:
# LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

# Where runtime state lives (agent keys, tokens, receipts, ledger). Git-ignored.
DATA_DIR=.data

# ---- Telegram (optional; everything falls back to the dashboard if unset) ---
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_OWNER_CHAT_ID=123456789   # or send /start to the bot to pair

# ---- Base Sepolia only (CHAIN_MODE=base-sepolia) -----------------------------
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# X402_FACILITATOR_URL=https://x402.org/facilitator
# MERCHANT_PRIVATE_KEY=0x...        # company wallet paying bounties (needs testnet USDC + ETH)

# ---- Owner API key (approve/deny, freeze, policy, top-up, facilitator admin) --
# Always required. If unset, `npm run setup` generates one into .data/owner-key.json and every
# owner-side client (dashboard proxy, notifier, demo, reset) reads it from there.
# OWNER_API_KEY=change-me

# ---- Shopify (optional) --------------------------------------------------------
# Agents can shop at any public Shopify store; nothing here is required.
# SHOPIFY_API_VERSION=2026-10
# Optional: a public HTTPS UCP agent profile, used for stores whose Storefront API isn't public.
# UCP_AGENT_PROFILE_URL=

# ---- Capital One bank (optional, Nessie sandbox; docs/ARCHITECTURE.md §16) -------
# With a key, each agent gets a Capital One allowance account funded from your checking, and its
# payments show on that account's statement. Without one, nothing changes. Sandbox money only.
# NESSIE_API_KEY=
# NESSIE_BASE_URL=https://api.nessieisreal.com
# NESSIE_OPENING_BALANCE=5000.00

# ---- Quantcomm research (optional; docs/ARCHITECTURE.md §17) ----------------------
# The bridge sells Quantcomm's flood and bank research to agents over x402. Quantcomm itself runs
# from its own repo: cd ../technica2026 && .venv/bin/python -m quantcomm.web
# QUANTCOMM_URL=http://127.0.0.1:8000
# QUANTCOMM_BRIDGE_PORT=4080
# QUANTCOMM_BRIDGE_URL=http://localhost:4080

# ---- Computer use (optional, needs Docker; docs/ARCHITECTURE.md §19) --------------
# A sandboxed Chromium desktop agents rent by the minute and pay per action. The image builds on
# first start (or: npm run computer-use:image).
# COMPUTER_USE_PORT=4090
# COMPUTER_USE_URL=http://localhost:4090
# COMPUTER_USE_SEATS=1
# COMPUTER_USE_START_GRACE_SECONDS=90
# COMPUTER_USE_MAX_SESSION_MINUTES=30
# COMPUTER_USE_CPUS=1
# COMPUTER_USE_MEMORY=1g
# COMPUTER_USE_ACCESS=ip            # "publish" on Docker Desktop (macOS/Windows)
# ALLOWANCE_COMPUTER_TOOLS=0        # hide the computer_* tools from Claude Desktop
